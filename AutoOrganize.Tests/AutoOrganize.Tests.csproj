<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>AutoOrganize.Tests</AssemblyName>
    <RootNamespace>AutoOrganize.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoOrganize\AutoOrganize.csproj" />
    <!--
      Jellyfin supplies these runtime assemblies to the plugin in production.
      The standalone regression runner references the same versions directly
      so `dotnet run` also has them in its local output directory.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Naming" Version="10.11.11" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
