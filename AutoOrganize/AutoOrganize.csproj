<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Web\autoorganizelog.html" />
    <None Remove="Web\autoorganizelog.js" />
    <None Remove="Web\autoorganizemovie.html" />
    <None Remove="Web\autoorganizemovie.js" />
    <None Remove="Web\autoorganizesmart.html" />
    <None Remove="Web\autoorganizesmart.js" />
    <None Remove="Web\autoorganizetv.html" />
    <None Remove="Web\autoorganizetv.js" />
    <None Remove="Web\fileorganizer.js" />
    <None Remove="Web\fileorganizer.template.html" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\autoorganizelog.html" />
    <EmbeddedResource Include="Web\autoorganizelog.js" />
    <EmbeddedResource Include="Web\autoorganizesmart.html" />
    <EmbeddedResource Include="Web\autoorganizesmart.js" />
    <EmbeddedResource Include="Web\autoorganizemovie.html" />
    <EmbeddedResource Include="Web\autoorganizemovie.js" />
    <EmbeddedResource Include="Web\autoorganizetv.html" />
    <EmbeddedResource Include="Web\autoorganizetv.js" />
    <EmbeddedResource Include="Web\fileorganizer.js" />
    <EmbeddedResource Include="Web\fileorganizer.template.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Naming" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11" ExcludeAssets="runtime" />
    <PackageReference Include="SearchPioneer.Lingua" Version="1.0.5" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <Target Name="CreateReleasePackage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PluginPackageDirectory>$(IntermediateOutputPath)plugin-package</PluginPackageDirectory>
      <PluginPackagePath>$(TargetDir)AutoOrganize_$(Version).zip</PluginPackagePath>
    </PropertyGroup>
    <ItemGroup>
      <ExistingPluginPackages Include="$(TargetDir)AutoOrganize_*.zip" />
      <PluginLanguageModels Include="$(TargetDir)Lingua\LanguageModels\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(PluginPackageDirectory)" />
    <Delete Files="@(ExistingPluginPackages)" />
    <MakeDir Directories="$(PluginPackageDirectory)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)Lingua.dll" DestinationFolder="$(PluginPackageDirectory)" />
    <Copy
      SourceFiles="@(PluginLanguageModels)"
      DestinationFiles="@(PluginLanguageModels->'$(PluginPackageDirectory)\Lingua\LanguageModels\%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(PluginPackageDirectory)" DestinationFile="$(PluginPackagePath)" Overwrite="true" />
  </Target>

</Project>
